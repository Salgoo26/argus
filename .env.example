# ─────────────────────────────────────────────────────────────
# 로컬 개발용 환경변수 예시 — 값은 전부 더미다.
# 사용법: 이 파일을 .env로 복사한 뒤 change-me를 실제 값으로 바꾼다.
#   cp .env.example .env
# .env는 .gitignore로 커밋되지 않는다. (CLAUDE.md 3절 #1 — 시크릿 커밋 금지)
# 무작위 값 생성 예: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# docker compose를 레포 루트에서 실행할 수 있게 compose 파일 위치를 지정
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=argus

# ── 플랫폼 DB (감시 대상 커머스) ─────────────────────────────
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform_owner
PLATFORM_DB_PASSWORD=change-me
# 호스트에서 접속할 포트 (127.0.0.1에만 바인딩)
PLATFORM_DB_PORT=15432

# ── Argus DB (접속기록 원장) ──────────────────────────────────
# 플랫폼 DB와 별도 인스턴스 — 한쪽 슈퍼유저가 다른 쪽을 만질 수 없게 (architecture 1절)
ARGUS_DB_NAME=argus
# 소유자 계정 — 마이그레이션 전용. API는 이 계정으로 접속하지 않는다
ARGUS_DB_USER=argus_owner
ARGUS_DB_PASSWORD=change-me
ARGUS_DB_PORT=15433
# 앱 계정 — argus-api가 접속하는 계정 (argus_app 롤 멤버: access_log는 SELECT·INSERT만, §8③)
# argus-migrate가 기동 시 생성하고 비밀번호를 이 값으로 맞춘다. 비밀번호는 16자 이상.
# 비밀번호에는 URL 특수문자(@ : / ? #)를 쓰지 않는다 (hex 권장)
ARGUS_APP_DB_USER=argus_api
ARGUS_APP_DB_PASSWORD=change-me-at-least-16-chars

# ── platform-api (M2~) ───────────────────────────────────────
# 호스트에서 접속할 포트 (127.0.0.1에만 바인딩)
PLATFORM_API_PORT=18001
# 관리자 로그인 토큰(JWT HS256) 서명 키 — 32자 이상 (openssl rand -hex 32). 짧으면 기동 거부
PLATFORM_AUTH_SECRET=change-me
# 시드 취급자 5명(ops_park 등)의 로그인 비밀번호 — 12자 이상(짧으면 시드 거부). 로컬 시연용
PLATFORM_SEED_OPERATOR_PASSWORD=change-me
# 접속 IP 헤더(X-Forwarded-For)를 믿을 프록시 — 쉼표 구분 IP·CIDR (CLAUDE.md 3절 #10)
# 로컬은 비워 둔다(아무도 믿지 않음 — 화면 서버 platform-web도 믿지 않는다). 운영은 Caddy 주소
PLATFORM_TRUSTED_PROXIES=
# 플랫폼 관리자 화면(platform-web) 호스트 포트 (127.0.0.1에만 바인딩)
PLATFORM_WEB_PORT=3000

# ── argus-api ────────────────────────────────────────────────
# 호스트에서 접속할 포트 (127.0.0.1에만 바인딩)
ARGUS_API_PORT=18000
# 담당자·취급자 로그인 토큰(JWT HS256) 서명 키 — 32자 이상 (openssl rand -hex 32). 짧으면 기동 거부
ARGUS_AUTH_SECRET=change-me
# 접속 IP 헤더(X-Forwarded-For)를 믿을 프록시 — 쉼표 구분 IP·CIDR. 로컬은 비워 둔다
ARGUS_TRUSTED_PROXIES=

# ── 시스템 간 인증 (M1~) ──────────────────────────────────────
# 플랫폼 → Argus 수집 API HMAC-SHA256 공유 비밀키 (api-spec 1-2)
# 양쪽(platform-relay, argus-api)에 같은 값을 넣는다.
ARGUS_INGEST_SECRET_PLATFORM=change-me

# ── 결제수단 암호화 키 (Skeleton 이후) ────────────────────────
# §7②5·6호 — DB와 분리 보관
PAYMENT_ENCRYPTION_KEY=change-me
